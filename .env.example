# Copy to .env. Do not commit populated credentials.
APP_ENV=dev

# Same names as the existing ExamPaperFormatter / ExamHelper project.
OPENAI_API_KEY=
# REV2 keeps Avnish's model; the earlier app's gpt-4.1 is not a validated REV2 substitution.
EXAM_REDO_MODEL=gpt-6-astra
VERIFY_TOKEN=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_VERSION=v25.0
# Default true. Set false explicitly to skip webhook signature checks during beta.
WHATSAPP_VERIFY_SIGNATURE=true
# Required only when WHATSAPP_VERIFY_SIGNATURE=true.
WHATSAPP_APP_SECRET=
WHATSAPP_ASYNC=true
WHATSAPP_HTTP_TIMEOUT=60
# Persistent path, e.g. /var/data. Blank defaults to this project's data folder.
EXAM_DATA_ROOT=
# INFO shows all main stages; DEBUG adds every polling cycle.
LOG_LEVEL=INFO
PORT=8000

# Additional REV2 settings with no equivalent in the older project.
OPENAI_REASONING_EFFORT=high
ADMIN_PASSWORD=1234

WEB_TEACHER_ACCESS_CODE=
# Set true on HTTPS hosting; false for local HTTP development.
COOKIE_SECURE=false
MAX_UPLOAD_MB=15
SESSION_MINUTES=30
RETENTION_DAYS=7
# Optional beta allowlist: international numbers without +, comma separated.
WHATSAPP_ALLOWED_SENDERS=

# Fallback aliases still accepted if the corresponding primary name is blank:
# OPENAI_MODEL -> EXAM_REDO_MODEL
# WHATSAPP_ACCESS_TOKEN -> WHATSAPP_TOKEN
# WHATSAPP_VERIFY_TOKEN -> VERIFY_TOKEN
# WHATSAPP_API_VERSION -> WHATSAPP_GRAPH_VERSION
# EXAM_DATA_DIR -> EXAM_DATA_ROOT
# GUNICORN_* settings belong to the older Flask server and are not used by REV2.
