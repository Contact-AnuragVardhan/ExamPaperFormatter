APP_ENV=dev

# Existing formatter
OPENAI_API_KEY=
EXAM_REDO_MODEL=gpt-4.1

# Same WhatsApp variable names as ExamHelper / Student Evaluator.
VERIFY_TOKEN=change_me
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_VERSION=v25.0

# Optional: if supplied, POST /webhook verifies X-Hub-Signature-256.
WHATSAPP_APP_SECRET=

# Project-specific Flask/WhatsApp behavior.
WHATSAPP_ASYNC=true
WHATSAPP_HTTP_TIMEOUT=60

# Optional deployment/runtime settings
# Set to /var/data if a Render persistent disk is mounted there.
EXAM_DATA_ROOT=
LOG_LEVEL=INFO

# Gunicorn/Render defaults (used by start.sh)
GUNICORN_WORKERS=1
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=300
