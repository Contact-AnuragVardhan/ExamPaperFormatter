APP_ENV=prod

VERIFY_TOKEN=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_VERSION=v25.0

OPENAI_API_KEY=
EXAM_REDO_MODEL=gpt-4.1

# Optional signature validation.
WHATSAPP_APP_SECRET=

# Project-specific Flask/WhatsApp runtime settings.
WHATSAPP_ASYNC=true
WHATSAPP_HTTP_TIMEOUT=60

# Optional. If you attach a Render persistent disk at /var/data, set this to /var/data.
EXAM_DATA_ROOT=

GUNICORN_WORKERS=1
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=300
