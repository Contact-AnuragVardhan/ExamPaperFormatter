APP_ENV=prod
OPENAI_API_KEY=
EXAM_REDO_MODEL=gpt-6-astra
VERIFY_TOKEN=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_VERSION=v25.0
# Verify incoming WhatsApp messages before trusting their sender numbers.
WHATSAPP_VERIFY_SIGNATURE=true
WHATSAPP_APP_SECRET=
WHATSAPP_ASYNC=true
WHATSAPP_HTTP_TIMEOUT=60
EXAM_DATA_ROOT=/var/data
# INFO shows all main stages; DEBUG adds every polling cycle.
LOG_LEVEL=INFO
PORT=10000
OPENAI_REASONING_EFFORT=high
ADMIN_PASSWORD=
WEB_TEACHER_ACCESS_CODE=

# Same PostgreSQL connection string used by Teacher Helper.
DATABASE_URL=
COOKIE_SECURE=true
MAX_UPLOAD_MB=15
SESSION_MINUTES=30
RETENTION_DAYS=7
WHATSAPP_ALLOWED_SENDERS=
